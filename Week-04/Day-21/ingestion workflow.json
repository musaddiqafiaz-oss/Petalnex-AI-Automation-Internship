    {
      "parameters": {
        "jsCode": "// Inspect retrieved chunks.\n// NOTE: this Supabase Vector Store node returns items shaped like\n// { document: { pageContent, metadata } } - the content/metadata are\n// nested under \"document\", not flat on the item. Read from there.\nconst docs = items\n  .map(i => i.json.document || i.json)\n  .filter(d => d && (d.pageContent || d.content));\n\nif (docs.length === 0) {\n  return [{ json: { inKnowledgeBase: false, context: '', sources: [] } }];\n}\n\nconst context = docs.map(d => `Source: ${d.metadata?.source || d.metadata?.title || 'unknown'}\\n${d.pageContent || d.content}`).join('\\n\\n---\\n\\n');\nconst sources = [...new Set(docs.map(d => d.metadata?.source || d.metadata?.title || 'unknown'))];\n\nreturn [{\n  json: {\n    inKnowledgeBase: true,\n    context,\n    sources\n  }\n}];\n"
      },
