    {
      "parameters": {
        "jsCode": "// Clean Content step\n// Trims whitespace, collapses newlines/extra spaces, strips stray HTML tags\nfor (const item of $input.all()) {\n  let content = (item.json.content ?? '').toString();\n  content = content\n    .replace(/<[^>]*>/g, ' ')   // strip any HTML tags\n    .replace(/\\s+/g, ' ')       // collapse whitespace/newlines\n    .trim();\n\n  item.json.content = content;\n  item.json.title = (item.json.title ?? '').toString().trim();\n  item.json.category = (item.json.category ?? '').toString().trim();\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
