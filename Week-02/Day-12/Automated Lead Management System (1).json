    {
      "parameters": {
        "jsCode": "const lead = $json.body || $json;\n\nconst requiredFields = [\n  \"name\",\n  \"email\",\n  \"company\",\n  \"service\",\n  \"budget\"\n];\n\nconst missingFields = requiredFields.filter(\n  field =>\n    lead[field] === undefined ||\n    lead[field] === null ||\n    lead[field] === \"\"\n);\n\nif (missingFields.length > 0) {\n  return [\n    {\n      json: {\n        valid: false,\n        status: \"Rejected\",\n        reason: `Missing fields: ${missingFields.join(\", \")}`,\n        ...lead\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      valid: true,\n      ...lead\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "85b0287a-9fbd-4506-816b-b7de4c501ac0",
      "name": "Validate lead"
    },
    {
