      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "const budget = Number($json.budget);\n\nreturn [\n  {\n    json: {\n      ...$json,\n      budget,\n      leadStatus: \"New\",\n      processedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -64
      ],
      "id": "5793e6bb-b875-492a-9204-a7f1f8ed901e",
      "name": "lead processing"
    },
    {
      "parameters": {
        "jsCode": "const budget = Number($json.budget);\nconst service = String($json.service).toLowerCase();\n\nlet score = 0;\n\nif (budget >= 150000) {\n  score += 50;\n} else if (budget >= 75000) {\n  score += 30;\n} else {\n  score += 10;\n}\n\nif (service.includes(\"ai\")) {\n  score += 30;\n} else if (service.includes(\"web\")) {\n  score += 20;\n} else {\n  score += 10;\n}\n\nlet priority;\n\nif (score >= 70) {\n  priority = \"High\";\n} else if (score >= 40) {\n  priority = \"Medium\";\n} else {\n  priority = \"Low\";\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      score,\n      priority\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
